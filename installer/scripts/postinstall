#!/bin/sh
# Reload the audio service so the "Scarlett Volume" driver appears,
# then open the app in the logged-in user's session.
killall coreaudiod 2>/dev/null || true
sleep 2

CONSOLE_USER="$(stat -f%Su /dev/console)"
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    su "$CONSOLE_USER" -c 'open "/Applications/Scarlett Volume.app"' || true
fi
exit 0
